{
  "name": "@stackcloud/schema-form",
  "version": "0.3.0",
  "description": "Schema Form — schema-driven form inputs for Nuxt 4, built on Nuxt UI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darisgrokbot-cloud/schema-form.git"
  },
  "homepage": "https://schema-form.stackcloud.cc",
  "bugs": {
    "url": "https://github.com/darisgrokbot-cloud/schema-form/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./core": {
      "types": "./dist/runtime/core/index.d.ts",
      "import": "./dist/runtime/core/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "core": [
        "./dist/runtime/core/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground --port 3333",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "build": "nuxt-module-build build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.13.0",
    "nuxt": "^4.0.0",
    "@internationalized/date": "^3.12.4"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.158",
    "@nuxt/kit": "^4.6.4",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/ui": "^4.13.0",
    "@types/node": "^26.6.6",
    "nuxt": "^4.6.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "@internationalized/date": "^3.12.4"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt-ui",
    "form",
    "schema",
    "schema-form",
    "dynamic-form"
  ],
  "engines": {
    "node": ">=20"
  }
}
